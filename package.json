{
  "name": "android-vscode-support",
  "displayName": "Android VS Code Support",
  "description": "Native Android development support for VS Code",
  "version": "0.1.0",
  "publisher": "desodre",
  "license": "MIT",
  "private": true,
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:kotlin",
    "onLanguage:java",
    "onCommand:androidSupport.diagnose",
    "onCommand:androidSupport.adbVersion",
    "onCommand:androidSupport.listDevices",
    "onCommand:androidSupport.selectDevice",
    "onCommand:androidSupport.logcat",
    "onCommand:androidSupport.stopLogcat",
    "onCommand:androidSupport.attachDebugger",
    "onCommand:androidSupport.debug",
    "onCommand:androidSupport.startAvd",
    "onCommand:androidSupport.run",
    "onCommand:androidSupport.stop",
    "onCommand:androidSupport.build",
    "onCommand:androidSupport.bundle",
    "onCommand:androidSupport.install",
    "onCommand:androidSupport.clean",
    "onCommand:androidSupport.selectModule",
    "onCommand:androidSupport.selectVariant"
  ],
  "contributes": {
    "commands": [
      { "command": "androidSupport.diagnose", "title": "Android: Diagnosticar ambiente" },
      { "command": "androidSupport.adbVersion", "title": "Android: Versão do servidor ADB" },
      { "command": "androidSupport.listDevices", "title": "Android: Listar dispositivos" },
      { "command": "androidSupport.selectDevice", "title": "Android: Selecionar dispositivo" },
      { "command": "androidSupport.logcat", "title": "Android: Iniciar Logcat" },
      { "command": "androidSupport.stopLogcat", "title": "Android: Parar Logcat" },
      { "command": "androidSupport.attachDebugger", "title": "Android: Conectar depurador ao aplicativo em execução" },
      { "command": "androidSupport.debug", "title": "Android: Compilar, instalar e depurar aplicativo" },
      { "command": "androidSupport.startAvd", "title": "Android: Iniciar AVD existente" },
      { "command": "androidSupport.run", "title": "Android: Compilar, instalar e executar aplicativo" },
      { "command": "androidSupport.stop", "title": "Android: Parar aplicativo selecionado" },
      { "command": "androidSupport.build", "title": "Android: Compilar variante selecionada" },
      { "command": "androidSupport.bundle", "title": "Android: Gerar AAB da variante selecionada" },
      { "command": "androidSupport.install", "title": "Android: Instalar variante selecionada" },
      { "command": "androidSupport.clean", "title": "Android: Limpar módulo selecionado" },
      { "command": "androidSupport.selectModule", "title": "Android: Selecionar módulo" },
      { "command": "androidSupport.selectVariant", "title": "Android: Selecionar variante" }
    ],
    "taskDefinitions": [{
      "type": "androidGradle",
      "required": ["action", "module", "variant", "rootPath"],
      "properties": {
        "action": { "type": "string", "enum": ["assemble", "bundle", "clean"] },
        "module": { "type": "string" },
        "variant": { "type": "string" },
        "rootPath": { "type": "string" }
      }
    }],
    "configuration": {
      "title": "Android VS Code Support",
      "properties": {
        "androidSupport.javaHome": { "type": "string", "default": "", "description": "Caminho do JDK 17+ usado pelo serviço Kotlin. Vazio usa JAVA_HOME ou java no PATH." },
        "androidSupport.sdkPath": { "type": "string", "default": "", "description": "Caminho do Android SDK. Vazio usa ANDROID_HOME, ANDROID_SDK_ROOT ou o caminho padrão." },
        "androidSupport.emulatorPath": { "type": "string", "default": "", "description": "Caminho absoluto do executável Android Emulator. Vazio usa o emulador do SDK detectado." },
        "androidSupport.bridgeLibDirectory": { "type": "string", "default": "", "description": "Diretório lib da distribuição Kotlin. Vazio usa o serviço incluído na extensão." },
        "androidSupport.adbHost": { "type": "string", "default": "127.0.0.1", "description": "Endereço do servidor ADB." },
        "androidSupport.adbPort": { "type": "number", "default": 5037, "minimum": 1, "maximum": 65535, "description": "Porta do servidor ADB." },
        "androidSupport.xmlLocalResourceDiagnostics": { "type": "boolean", "default": false, "description": "Avisar sobre referências XML não encontradas nos módulos locais indexados. Pode sinalizar recursos fornecidos por bibliotecas externas ou gerados." }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "check": "tsc --noEmit -p .",
    "test": "npm run compile && ./gradlew :bridge:test :bridge:installDist && node --test out/test/*.test.js",
    "build:bridge": "./gradlew :bridge:installDist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.9.3"
  }
}
